<!-- views/tile.hbs -->
{{#> layout}}
<div class="tile-container">
    <h1 class="tile-title">Укрупненные показатели стоимости</h1>
    
    <form class="search-form slider-form" action="/construction/tile" method="GET">
        
        <!-- Слайдер ОТ -->
        <div class="slider-group">
            <div class="slider-header">
                <label for="min-slider">
                    От: <b>{{currentMin}} руб/м²</b>
                </label>
            </div>
            <div class="search-bar slider-bar">
                <span class="slider-bound">{{minLimit}}</span>
                <input 
                    type="range" 
                    id="min-slider"
                    name="minPrice" 
                    min="{{minLimit}}"
                    max="{{maxLimit}}"
                    value="{{currentMin}}" 
                    class="search-slider"
                >
                <span class="slider-bound">{{maxLimit}}</span>
            </div>
        </div>

        <!-- Слайдер ДО -->
        <div class="slider-group">
            <div class="slider-header">
                <label for="max-slider">
                    До: <b>{{currentMax}} руб/м²</b>
                </label>
            </div>
            <div class="search-bar slider-bar">
                <span class="slider-bound">{{minLimit}}</span>
                <input 
                    type="range" 
                    id="max-slider"
                    name="maxPrice" 
                    min="{{minLimit}}"
                    max="{{maxLimit}}"
                    value="{{currentMax}}" 
                    class="search-slider"
                >
                <span class="slider-bound">{{maxLimit}}</span>
            </div>
        </div>

        <button type="submit" class="search-btn full-width-btn">Найти</button>
    </form>

    <div class="services-grid">
        {{#each ConstructionServices}}
            <a href="/construction/feed?id={{this.id}}" class="service-card" style="text-decoration: none; display: block;">
                <img src="http://localhost:9000/construction-assets/{{this.imageUrl}}" class="card-image">
                <div class="card-content">
                    <h3 class="card-title">{{this.title}}</h3>
                    <div class="card-price">{{this.price}} руб/м²</div>
                    <div class="card-likes">❤️ {{this.likesCount}}</div>
                </div>
            </a>
        {{else}}
            <p class="empty-message">Нет услуг по фильтру</p>
        {{/each}}
    </div>
</div>
{{/layout}}