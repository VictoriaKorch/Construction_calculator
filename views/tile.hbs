<!-- views/tile.hbs -->
{{#> layout}}
<style>
    .service-card-wrapper {
        background: #fff;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 2px 8px rgba(0,0,0,0.05);
        display: flex;
        flex-direction: column;
    }
    .card-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 4px 8px 4px;
        /* Убрали серую линию (border-top) */
        margin-top: auto; 
    }
    .btn-cian-delete {
        background: transparent;
        /* Сделали обводку чуть темнее */
        border: 1px solid #d0d4dc;
        /* Сделали текст чуть темнее */
        color: #737a8e;
        padding: 4px 10px;
        border-radius: 4px;
        font-size: 11px;
        cursor: pointer;
        transition: color 0.2s ease, border-color 0.2s ease;
    }
    .btn-cian-delete:hover {
        color: #ff5a5f;
        border-color: #ff5a5f;
    }
</style>

<div class="tile-container">
    <h1 class="tile-title">Укрупненные показатели стоимости</h1>
    
    <form class="search-form slider-form" action="/construction/tile" method="GET">
        <div class="slider-group">
            <div class="slider-header">
                <label for="min-slider">От: <b>{{currentMin}} руб/м²</b></label>
            </div>
            <div class="search-bar slider-bar">
                <span class="slider-bound">{{minLimit}}</span>
                <input type="range" id="min-slider" name="minPrice" min="{{minLimit}}" max="{{maxLimit}}" value="{{currentMin}}" class="search-slider">
                <span class="slider-bound">{{maxLimit}}</span>
            </div>
        </div>

        <div class="slider-group">
            <div class="slider-header">
                <label for="max-slider">До: <b>{{currentMax}} руб/м²</b></label>
            </div>
            <div class="search-bar slider-bar">
                <span class="slider-bound">{{minLimit}}</span>
                <input type="range" id="max-slider" name="maxPrice" min="{{minLimit}}" max="{{maxLimit}}" value="{{currentMax}}" class="search-slider">
                <span class="slider-bound">{{maxLimit}}</span>
            </div>
        </div>

        <button type="submit" class="search-btn full-width-btn">Найти</button>
    </form>

    <div class="services-grid">
        {{#each ConstructionServices}}
            <div class="service-card-wrapper">
                <a href="/construction/feed?id={{this.id}}" class="service-card" style="text-decoration: none; display: block; padding-bottom: 4px;">
                    {{#if this.imageUrl}}
                        <img src="http://localhost:9000/construction-assets/{{this.imageUrl}}" class="card-image">
                    {{else}}
                        <img src="/img/default.jpg" class="card-image" style="background:#f1f2f4;">
                    {{/if}}
                    <div class="card-content">
                        <h3 class="card-title">{{this.title}}</h3>
                        <div class="card-price">{{this.price}} руб/м²</div>
                    </div>
                </a>
                
                <div class="card-footer">
                    <div class="card-likes">❤️ {{this.likesCount}}</div>
                    <form action="/construction/delete" method="POST" style="margin: 0;">
                        <input type="hidden" name="service_id" value="{{this.id}}">
                        <button type="submit" class="btn-cian-delete">Удалить</button>
                    </form>
                </div>
            </div>
        {{else}}
            <p class="empty-message">Нет услуг по фильтру</p>
        {{/each}}
    </div>
</div>
{{/layout}}