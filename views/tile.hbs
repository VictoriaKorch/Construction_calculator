<!-- views/tile.hbs -->
{{#> layout}}
<div class="tile-container">
    <h1 class="tile-title">Укрупненные показатели стоимости</h1>
    
    <!-- Компактная строка фильтрации -->
    <form class="search-form" action="/construction/tile" method="GET">
        <div class="search-bar">
            <input 
                type="number" 
                name="filterPrice" 
                value="{{currentFilter}}" 
                placeholder="Макс. цена за м²..." 
                class="search-input"
            >
            <button type="submit" class="search-btn">Найти</button>
            
            <!-- Крестик сброса появляется только если есть текущий фильтр -->
            {{#if currentFilter}}
                <a href="/construction/tile" class="clear-btn" title="Сбросить фильтр">✕</a>
            {{/if}}
        </div>
    </form>

    <div class="services-grid">
        {{#each services}}
            <div class="service-card" onclick="window.location.href='/construction/feed?id={{this.id}}'">
                <img src="http://localhost:9000/construction-assets/{{this.imageUrl}}" class="card-image">
                <div class="card-content">
                    <h3 class="card-title">{{this.title}}</h3>
                    <div class="card-price">{{this.price}} руб/м²</div>
                    <div class="card-likes">❤️ {{this.likesCount}}</div>
                </div>
            </div>
        {{else}}
            <p class="empty-message">Нет услуг по фильтру</p>
        {{/each}}
    </div>
</div>
{{/layout}}