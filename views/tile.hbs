<!-- views/tile.hbs -->
{{#> layout}}
<div class="tile-container">
    <h1 class="tile-title">Укрупненные показатели стоимости</h1>
    
    <form class="filter-form" action="/construction/tile" method="GET">
        <div class="filter-group">
            <label for="filterPrice">Макс. цена (руб/м²)</label>
            <input type="number" id="filterPrice" name="filterPrice" value="{{currentFilter}}" placeholder="Например, 50000">
            <button type="submit" class="btn btn-primary">Фильтр</button>
            <a href="/construction/tile" class="btn btn-secondary">Сброс</a>
        </div>
    </form>

    <div class="services-grid">
        {{#each services}}
            <div class="service-card" onclick="window.location.href='/construction/feed?id={{this.id}}'">
                <img src="http://localhost:9000/construction-assets/{{this.imageUrl}}" class="card-image">
                <div class="card-content">
                    <h3 class="card-title">{{this.title}}</h3>
                    <div class="card-price">💰 {{this.price}} руб/м²</div>
                    <div class="card-likes">❤️ {{this.likesCount}}</div>
                </div>
            </div>
        {{else}}
            <p class="empty-message">Нет услуг по фильтру</p>
        {{/each}}
    </div>
</div>
{{/layout}}