<!-- views/add.hbs -->
{{#> layout}}
<div class="add-container" style="min-height: calc(100vh - 70px); padding-bottom: 30px;">
    <h1 class="page-title">{{#if hasDraft}}Публикация проекта{{else}}Новый проект{{/if}}</h1>

    {{#if hasDraft}}
        <!-- Шаг 2: Черновик существует -->
        <form class="add-form" action="/construction/publish" method="POST" novalidate>
            <input type="hidden" name="id" value="{{ConstructionService.id}}">
            
            <div class="field-card">
                <label>Файл изображения</label>
                <input type="file" accept="image/*" class="file-input" style="margin-bottom: 12px;">
                <div class="media-card" style="margin-top: 10px;">
                    {{#if ConstructionService.imageUrl}}
                        <img src="http://localhost:9000/construction-assets/{{ConstructionService.imageUrl}}" class="preview-image" alt="Превью фото">
                    {{else}}
                        <img src="/img/default.jpg" class="preview-image" alt="Превью фото">
                    {{/if}}
                </div>
            </div>
            <div class="field-card">
                <label>Файл видео</label>
                <input type="file" accept="video/*" class="file-input" style="margin-bottom: 12px;">
                <div class="media-card" style="margin-top: 10px;">
                    <video class="preview-video" controls style="width: 100%;">
                        {{#if ConstructionService.videoUrl}}
                            <source src="http://localhost:9000/construction-assets/{{ConstructionService.videoUrl}}" type="video/mp4">
                        {{else}}
                            <source src="/img/default-video.mp4" type="video/mp4">
                        {{/if}}
                    </video>
                </div>
            </div>
            <div class="field-card">
                <label>Название проекта</label>
                <input type="text" name="title" value="{{ConstructionService.title}}" {{#if errorTitle}}style="background-color: rgba(255, 0, 0, 0.05); border-color: red;"{{/if}} required>
            </div>
            
            <div class="field-card">
                <label>Описание</label>
                <textarea name="description" {{#if errorDesc}}style="background-color: rgba(255, 0, 0, 0.05); border-color: red;"{{/if}}>{{ConstructionService.description}}</textarea>
            </div>
            <div class="field-card">
                <label>Цена (руб/м²)</label>
                <input type="number" name="price" value="{{ConstructionService.price}}" {{#if errorPrice}}style="background-color: rgba(255, 0, 0, 0.05); border-color: red;"{{/if}}>
            </div>
            <div class="field-card">
                <label>Площадь (м²)</label>
                <input type="number" name="area" value="{{ConstructionService.area}}" {{#if errorArea}}style="background-color: rgba(255, 0, 0, 0.05); border-color: red;"{{/if}}>
            </div>
            
            <button type="submit" class="search-btn full-width-btn" style="margin-top: 15px;">Опубликовать</button>
        </form>
    {{else}}
        <!-- Шаг 1: Черновика нет -->
        <form class="add-form" action="/construction/add-draft" method="POST" novalidate>
            <div class="field-card">
                <label>Файл изображения</label>
                <input type="file" accept="image/*" class="file-input" style="margin-bottom: 12px;">
                <div class="media-card" style="margin-top: 10px;">
                    <img src="/img/default.jpg" class="preview-image" alt="Превью фото">
                </div>
            </div>
            <div class="field-card">
                <label>Файл видео</label>
                <input type="file" accept="video/*" class="file-input" style="margin-bottom: 12px;">
                <div class="media-card" style="margin-top: 10px;">
                    <video class="preview-video" controls style="width: 100%;">
                        <source src="/img/default-video.mp4" type="video/mp4">
                    </video>
                </div>
            </div>
            <div class="field-card">
                <label>Название проекта</label>
                <input type="text" name="title" {{#if errorTitle}}style="background-color: rgba(255, 0, 0, 0.05); border-color: red;"{{/if}}>
            </div>
            <button type="submit" class="search-btn full-width-btn" style="margin-top: 15px;">Далее</button>
        </form>
    {{/if}}
</div>
{{/layout}}