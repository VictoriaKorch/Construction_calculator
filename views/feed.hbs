<!-- views/feed.hbs -->
{{#> layout}}
<div class="feed-container">
    {{#if ConstructionService}}
        <div class="video-wrapper">
            <video 
                src="http://localhost:9000/construction-assets/{{ConstructionService.videoUrl}}" 
                class="feed-video" 
                autoplay 
                muted 
                loop 
                playsinline>
            </video>

            <div class="feed-sidebar">
                <div class="sidebar-item">
                    <div class="sidebar-icon">❤️</div>
                    <span class="sidebar-text">{{likesCount}}</span>
                </div>
                <a href="/construction/feed?id={{ConstructionService.id}}&next=true" class="sidebar-item next-btn">
                    <div class="sidebar-icon">↓</div>
                    <span class="sidebar-text">Далее</span>
                </a>
            </div>

            <div class="video-overlay">
                <div class="feed-content">
                    
                    <div class="title-row">
                        <h2 class="service-title">{{ConstructionService.title}}</h2>
                        <div class="service-details">
                            <span class="detail-item">{{ConstructionService.price}} руб/м²</span>
                            <span class="detail-item">{{ConstructionService.area}} м²</span>
                        </div>
                    </div>
                    
                    <div class="description-wrapper">
                        <input type="checkbox" id="desc-toggle" class="desc-checkbox">
                        
                        <div class="service-description">
                            {{ConstructionService.description}} В расчет укрупненного показателя стоимости включены: базовые строительно-монтажные работы (СМР), устройство фундамента и подведение наружных инженерных сетей до границы участка.
                        </div>
                        
                        <label for="desc-toggle" class="toggle-description" data-more="Еще" data-less="Скрыть"></label>
                    </div>
                </div>
            </div>
        </div>
    {{else}}
        <div class="empty-state"><p>Нет доступных проектов</p></div>
    {{/if}}
</div>
{{/layout}}