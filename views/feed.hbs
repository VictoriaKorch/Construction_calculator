<!-- views/feed.hbs -->
{{#> layout}}
<div class="feed-container">
    {{#if service}}
        <div class="video-wrapper">
            <video 
                src="http://localhost:9000/construction-assets/{{service.videoUrl}}" 
                class="feed-video" 
                autoplay 
                muted 
                loop 
                playsinline>
            </video>
            <div class="video-overlay">
                
                <!-- Левая/Нижняя часть: Текст и теги -->
                <div class="feed-content">
                    <h2 class="service-title">{{service.title}}</h2>
                    
                    <!-- Описание с кнопкой "больше/меньше" на чистом CSS -->
                    <div class="description-wrapper">
                        <input type="checkbox" id="desc-toggle" class="desc-checkbox">
                        <p class="service-description line-clamp">
                            {{service.description}}
                        </p>
                        <label for="desc-toggle" class="toggle-description" data-more="Больше" data-less="Меньше"></label>
                    </div>

                    <div class="service-details">
                        <span class="detail-item">💰 {{service.price}} руб/м²</span>
                        <span class="detail-item">📐 {{service.area}} м²</span>
                        <span class="detail-item">🏷️ {{service.category}}</span>
                    </div>
                </div>

                <!-- Правая часть: Лайки и Следующий (в стиле TikTok) -->
                <div class="feed-sidebar">
                    <!-- Лайки -->
                    <div class="sidebar-item">
                        <div class="sidebar-icon">❤️</div>
                        <span class="sidebar-text">{{likesCount}}</span>
                    </div>
                    
                    <!-- Кнопка Далее -->
                    <a href="/construction/feed?id={{service.id}}&next=true" class="sidebar-item next-btn">
                        <div class="sidebar-icon">⬇️</div>
                        <span class="sidebar-text">Далее</span>
                    </a>
                </div>

            </div>
        </div>
    {{else}}
        <div class="empty-state"><p>Нет доступных услуг</p></div>
    {{/if}}
</div>
{{/layout}}